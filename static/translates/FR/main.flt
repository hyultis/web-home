#global errors
FRONTERROR_SERVER_ERROR = Erreur serveur. Veuillez réessayer plus tard
FRONTERROR_SESSION_EXPIRED = Votre session a expiré. Veuillez vous reconnecter
FRONTERROR_CRYPTO_CONTEXT_MISSING = La clé de chiffrement cliente est indisponible. Aucune donnée n'a été envoyée
FRONTERROR_CRYPTO_STORAGE_FAILED = Le navigateur n'a pas pu conserver ou supprimer le contexte de chiffrement
FRONTERROR_CRYPTO_ENCRYPT_FAILED = Vos données n'ont pas pu être chiffrées. Rien n'a été envoyé
FRONTERROR_CRYPTO_DECRYPT_FAILED = Les données stockées n'ont pas pu être déchiffrées et n'ont pas été chargées
FRONTERROR_MODULE_OUTDATED = Le module est plus vieux que la version serveur
FRONTERROR_MODULE_NOTEXIST = Le module n'existe pas

