# Build with the same pinned Rust release as local development and CI.
FROM rust:1.97.0-slim-bookworm AS builder

ENV BUILDNAME="web-home" \
	LEPTOS_SASS_VERSION="1.86.0" \
	LEPTOS_WASM_OPT_VERSION="version_123" \
	LEPTOS_WASM_BINDGEN_VERSION="0.2.112"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
            ca-certificates libc6-dev libssl-dev make perl pkg-config && \
    rm -rf /var/lib/apt/lists/*

RUN rustup target add wasm32-unknown-unknown && \
    cargo install cargo-leptos --version 0.3.7 --locked

WORKDIR /work
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo ./.cargo
COPY src ./src
COPY static ./static
RUN cargo leptos build \
        --release \
        --precompress \
        --lib-cargo-args="--locked" \
        --bin-cargo-args="--locked"

RUN mkdir -p /runtime/static && \
    install -m 0755 "target/release/${BUILDNAME}" /runtime/leptosapp && \
    cp -a target/site /runtime/site && \
    cp -a static/translates /runtime/static/translates

FROM debian:bookworm-20260713-slim AS runner

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
            ca-certificates curl libssl3 libzstd1 zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 1000 webhome && \
    useradd --uid 1000 --gid webhome --no-create-home --home-dir /app --shell /usr/sbin/nologin webhome && \
    mkdir -p /app/config /app/dynamic && \
    chown -R webhome:webhome /app

WORKDIR /app

COPY --from=builder --chown=webhome:webhome /runtime/ /app/

ENV ENV="PROD"
ENV LEPTOS_ENV="PROD"
ENV LEPTOS_OUTPUT_NAME="webhome"
ENV LEPTOS_SITE_ADDR="0.0.0.0:3002"
ENV LEPTOS_SITE_ROOT=./site

USER webhome:webhome

EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD ["curl", "--fail", "--silent", "--show-error", "--max-time", "3", "http://127.0.0.1:3002/health"]

CMD ["/app/leptosapp"]
